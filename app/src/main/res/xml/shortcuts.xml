<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: jump straight into adding a receipt. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="scan"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutShortLabel="@string/shortcut_scan_short"
        android:shortcutLongLabel="@string/shortcut_scan_long">
        <intent
            android:action="com.alexivanov.receiptvault.action.SCAN"
            android:targetClass="com.alexivanov.receiptvault.MainActivity"
            android:targetPackage="com.alexivanov.receiptvault" />
    </shortcut>
    <shortcut
        android:shortcutId="manual"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_manual"
        android:shortcutShortLabel="@string/shortcut_manual_short"
        android:shortcutLongLabel="@string/shortcut_manual_long">
        <intent
            android:action="com.alexivanov.receiptvault.action.ADD_MANUALLY"
            android:targetClass="com.alexivanov.receiptvault.MainActivity"
            android:targetPackage="com.alexivanov.receiptvault" />
    </shortcut>
</shortcuts>
